// 数组方法测试：forEach / map / filter
// 这三个方法需要回调 gscript 函数，依赖方案 F 的 GSNativeFunction.call(args, interp) 重载
// 覆盖回调签名(element,index,array)、返回值、空数组、falsy 判断、链式调用、异常传播、闭包捕获

function check(name, expected, actual) {
    var mark = (expected == actual) ? "OK" : "FAIL";
    console.log("[" + mark + "] " + name + ": expected=" + expected + ", actual=" + actual);
}

console.log("=== [1] forEach 基础遍历 + 累加（闭包捕获外部变量）===");
var arr1 = [1, 2, 3, 4];
var sum = 0;
arr1.forEach(function(x) {
    sum = sum + x;
});
check("forEach-累加和", 10, sum);

console.log("=== [2] forEach 回调签名 (element, index, array) ===");
var arr2 = [10, 20, 30];
var collected = "";
arr2.forEach(function(elem, idx, array) {
    collected = collected + elem + "/" + idx + "/" + array.length + ";";
});
// 10/0/3;20/1/3;30/2/3;
check("forEach-回调签名", "10/0/3;20/1/3;30/2/3;", collected);

console.log("=== [3] forEach 返回 null（无返回值）===");
var arr3 = [1, 2];
var r3 = arr3.forEach(function(x) {});
check("forEach-返回null", null, r3);

console.log("=== [4] forEach 空数组（不调用 callback）===");
var empty = [];
var called = false;
empty.forEach(function(x) { called = true; });
check("forEach-空数组不回调", false, called);

console.log("=== [5] map 基础（收集返回值到新数组）===");
var arr5 = [1, 2, 3];
var doubled = arr5.map(function(x) { return x * 2; });
check("map-长度", 3, doubled.length);
check("map-doubled[0]", 2, doubled[0]);
check("map-doubled[1]", 4, doubled[1]);
check("map-doubled[2]", 6, doubled[2]);

console.log("=== [6] map 不修改原数组 ===");
check("map-原数组不变", 1, arr5[0]);
check("map-原数组长度不变", 3, arr5.length);

console.log("=== [7] map 空数组返回空数组 ===");
var emptyMap = empty.map(function(x) { return x; });
check("map-空数组长度", 0, emptyMap.length);

console.log("=== [8] map 回调签名 ===");
var arr8 = ["a", "b"];
var indexed = arr8.map(function(elem, idx, array) {
    return elem + idx;
});
check("map-回调签名[0]", "a0", indexed[0]);
check("map-回调签名[1]", "b1", indexed[1]);

console.log("=== [9] filter 基础（truthy 判断）===");
var arr9 = [1, 2, 3, 4, 5, 6];
var even = arr9.filter(function(x) { return x % 2 == 0; });
check("filter-偶数长度", 3, even.length);
check("filter-偶数[0]", 2, even[0]);
check("filter-偶数[1]", 4, even[1]);
check("filter-偶数[2]", 6, even[2]);

console.log("=== [10] filter falsy 值（0/\"\"/null 都被过滤）===");
var arr10 = [0, 1, "", "a", null, 2, 3.0];
var truthy = arr10.filter(function(x) { return x; });
check("filter-truthy长度", 4, truthy.length);
check("filter-truthy[0]", 1, truthy[0]);
check("filter-truthy[1]", "a", truthy[1]);
check("filter-truthy[2]", 2, truthy[2]);
check("filter-truthy[3]", 3, truthy[3]);

console.log("=== [11] filter 空数组 ===");
var emptyFilter = empty.filter(function(x) { return true; });
check("filter-空数组长度", 0, emptyFilter.length);

console.log("=== [12] filter 保留原元素（非 callback 返回值）===");
var arr12 = [1, 2, 3];
var filtered = arr12.filter(function(x) { return 99; });  // 返回 99（truthy），但保留原元素
check("filter-保留原元素[0]", 1, filtered[0]);
check("filter-保留原元素[1]", 2, filtered[1]);
check("filter-保留原元素[2]", 3, filtered[2]);

console.log("=== [13] 链式调用 map + filter ===");
var arr13 = [1, 2, 3, 4, 5];
var result = arr13.map(function(x) { return x * x; }).filter(function(x) { return x > 4; });
// [1,4,9,16,25] -> [9,16,25]
check("链式-长度", 3, result.length);
check("链式-[0]", 9, result[0]);
check("链式-[1]", 16, result[1]);
check("链式-[2]", 25, result[2]);

console.log("=== [14] 异常传播（callback 抛异常被外层 catch）===");
var arr14 = [1, 2, 3];
var caught = null;
try {
    arr14.forEach(function(x) {
        if (x == 2) throw "found two";
    });
} catch (e) {
    caught = e;
}
check("forEach-异常传播", "found two", caught);

// map 的异常传播
var caught2 = null;
try {
    arr14.map(function(x) {
        if (x == 3) throw "map error";
        return x;
    });
} catch (e) {
    caught2 = e;
}
check("map-异常传播", "map error", caught2);

console.log("=== [15] 闭包捕获（回调工厂函数）===");
function makeMultiplier(factor) {
    return function(x) { return x * factor; };
}
var arr15 = [1, 2, 3];
var tripled = arr15.map(makeMultiplier(3));
check("闭包-[0]", 3, tripled[0]);
check("闭包-[1]", 6, tripled[1]);
check("闭包-[2]", 9, tripled[2]);

console.log("=== [16] 回调内访问数组本身（array 参数）===");
var arr16 = [5, 10, 15];
var total = 0;
arr16.forEach(function(elem, idx, array) {
    total = total + array[idx];  // 通过 array[idx] 访问，等价于 elem
});
check("回调访问array参数", 30, total);

console.log("=== [17] map 返回不同类型（数值→字符串）===");
var arr17 = [1, 2, 3];
var strs = arr17.map(function(x) { return "n" + x; });
check("map-类型转换[0]", "n1", strs[0]);
check("map-类型转换[1]", "n2", strs[1]);
check("map-类型转换[2]", "n3", strs[2]);
