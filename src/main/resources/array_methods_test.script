// 数组方法测试：push / pop / shift / unshift / indexOf / join / slice
// 每个 check 打印 期望 vs 实际，便于人工核对

function check(name, expected, actual) {
    // 用 ==（松散相等）：string vs array 时一方为字符串会走 toStringValue 比较
    var mark = (expected == actual) ? "OK" : "FAIL";
    console.log("[" + mark + "] " + name + ": expected=" + expected + ", actual=" + actual);
}

console.log("=== [1] push ===");
var a = [1, 2, 3];
check("push前 length", 3, a.length);
var newLen = a.push(4, 5);
check("push返回新长度", 5, newLen);
check("push后 length", 5, a.length);
check("push后[3]", 4, a[3]);
check("push后[4]", 5, a[4]);
check("toString", "1,2,3,4,5", a);

console.log("=== [2] pop ===");
var popped = a.pop();
check("pop返回值", 5, popped);
check("pop后 length", 4, a.length);
check("pop后[3]", 4, a[3]);

console.log("=== [3] shift ===");
var shifted = a.shift();
check("shift返回值", 1, shifted);
check("shift后 length", 3, a.length);
check("shift后[0]", 2, a[0]);
check("shift后[1]", 3, a[1]);
check("shift后[2]", 4, a[2]);

console.log("=== [4] unshift ===");
var unshiftLen = a.unshift(0, 1);
check("unshift返回新长度", 5, unshiftLen);
check("unshift后 length", 5, a.length);
check("unshift后[0]", 0, a[0]);
check("unshift后[1]", 1, a[1]);
check("unshift后[2]", 2, a[2]);
check("toString", "0,1,2,3,4", a);

console.log("=== [5] indexOf ===");
check("indexOf(3)", 3, a.indexOf(3));
check("indexOf(99) 未找到", -1, a.indexOf(99));
check("indexOf(3, 4) 从idx4开始", -1, a.indexOf(3, 4));
check("indexOf(3, -2) 负索引", 3, a.indexOf(3, -2));

console.log("=== [6] join ===");
check("join() 默认逗号", "0,1,2,3,4", a.join());
check("join('-')", "0-1-2-3-4", a.join("-"));
check("join('')", "01234", a.join(""));
check("join('|') 单元素", "X", ["X"].join("|"));
check("join() 空数组", "", [].join());

console.log("=== [7] slice ===");
var s1 = a.slice();
check("slice() 拷贝 length", 5, s1.length);
check("slice() [0]", 0, s1[0]);
check("slice(2)", "2,3,4", a.slice(2));
check("slice(1, 3)", "1,2", a.slice(1, 3));
check("slice(-2) 负索引", "3,4", a.slice(-2));
check("slice(1, -1) 头尾负", "1,2,3", a.slice(1, -1));
check("slice(0, 0) 空", "", a.slice(0, 0));
check("slice 不修改原数组", 5, a.length);

console.log("=== [8] 空数组操作 ===");
var empty = [];
// null 只与 null 相等（== 也不等于 "null" 字符串），故用 "" + 转字符串再比较
check("空数组 pop", "null", "" + empty.pop());
check("空数组 shift", "null", "" + empty.shift());
check("空数组 push 返回长度", 1, empty.push("x"));
check("空数组 push 后[0]", "x", empty[0]);

console.log("=== [9] 混合操作 ===");
var stack = [];
stack.push("a");
stack.push("b");
stack.push("c");
check("栈: push 3次", "a,b,c", stack.join(","));
check("栈: pop", "c", stack.pop());
check("栈: pop", "b", stack.pop());
check("栈: 剩余", "a", stack.join(","));

var queue = [];
queue.push(10);
queue.push(20);
queue.push(30);
check("队列: shift", 10, queue.shift());
check("队列: shift", 20, queue.shift());
check("队列: 剩余", "30", queue.join(""));

console.log("=== 测试完成 ===");
