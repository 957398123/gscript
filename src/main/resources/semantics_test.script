// gscript 语义综合测试脚本
// 目的：系统验证各语法/语义的正确性，发现潜在 bug
// 输出格式："标签 : 实际值"，对照预期判断对错

function check(label, actual) {
    console.log(label + " : " + actual);
}

// ============ 1. 算术运算 ============
console.log("=== [1] 算术运算 ===");
check("1+2", 1 + 2);              // 预期 3
check("10-3", 10 - 3);            // 预期 7
check("4*5", 4 * 5);              // 预期 20
check("20/4", 20 / 4);            // 预期 5
check("7/2", 7 / 2);              // JS预期 3.5
check("3/2", 3 / 2);              // JS预期 1.5
check("7%3", 7 % 3);              // 预期 1
check("10%4", 10 % 4);            // 预期 2
check("2.5+1", 2.5 + 1);          // 预期 3.5
check("1+2.5", 1 + 2.5);          // 预期 3.5
check("2.5*2", 2.5 * 2);          // 预期 5.0
check("7.5/2.5", 7.5 / 2.5);      // 预期 3.0
check("0-5", 0 - 5);              // 预期 -5
check("-(-5)", -(-5));            // 预期 5
check("负号-5", -5);              // 预期 -5
// 10/0 整数除零已修复(返回NaN)，恢复测试
check("10/0", 10 / 0);           // 预期 NaN (gscript无Infinity，除零返回NaN)

// ============ 2. 比较运算 ============
console.log("=== [2] 比较运算 ===");
check("1==1", 1 == 1);            // 预期 true
check("1!=2", 1 != 2);            // 预期 true
check("1<2", 1 < 2);              // 预期 true
check("2<=2", 2 <= 2);            // 预期 true
check("3>2", 3 > 2);              // 预期 true
check("3>=3", 3 >= 3);            // 预期 true
check("1=='1'", 1 == "1");        // JS预期 true(隐式转换)
check("1==='1'", 1 === "1");      // 预期 false
check("1===1", 1 === 1);          // 预期 true
check("null==null", null == null);// 预期 true
check("'a'=='a'", "a" == "a");    // 预期 true
check("'a'<'b'", "a" < "b");      // 预期 true
check("5=='5'", 5 == "5");        // JS预期 true

// ============ 3. 逻辑运算与短路 ============
console.log("=== [3] 逻辑运算 ===");
check("true&&false", true && false);   // 预期 false
check("true||false", true || false);   // 预期 true
check("!true", !true);                 // 预期 false
check("!false", !false);               // 预期 true
check("!0", !0);                       // 预期 true (0 falsy)
check("!1", !1);                       // 预期 false
check("!''", !"");                     // 预期 true (空串 falsy)
check("!'x'", !"x");                   // 预期 false
check("!null", !null);                 // 预期 true
check("!(!1)", !(!1));                 // 预期 true (EBNF一元不嵌套，需括号)

// ============ 4. truthy/falsy 条件 ============
console.log("=== [4] 条件 truthy/falsy ===");
if ("x") { check("if('x')", "进入"); } else { check("if('x')", "未进入"); }       // 预期 进入
if ("") { check("if('')", "进入"); } else { check("if('')", "未进入"); }          // 预期 未进入
if (0) { check("if(0)", "进入"); } else { check("if(0)", "未进入"); }             // 预期 未进入
if (1) { check("if(1)", "进入"); } else { check("if(1)", "未进入"); }             // 预期 进入
if (null) { check("if(null)", "进入"); } else { check("if(null)", "未进入"); }    // 预期 未进入
if ({}) { check("if({})", "进入"); } else { check("if({})", "未进入"); }          // 预期 进入(对象truthy)
if ([]) { check("if([])", "进入"); } else { check("if([])", "未进入"); }          // 预期 进入(数组truthy)

// ============ 5. 位运算 ============
console.log("=== [5] 位运算 ===");
check("5&3", 5 & 3);              // 预期 1
check("5|2", 5 | 2);              // 预期 7
check("5^3", 5 ^ 3);              // 预期 6
check("~5", ~5);                  // 预期 -6
check("1<<3", 1 << 3);            // 预期 8
check("8>>2", 8 >> 2);            // 预期 2

// ============ 6. 自增自减 ============
console.log("=== [6] 自增自减 ===");
var a1 = 5;
check("a1++(表达式值)", a1++);     // 预期 5
check("a1++(后值)", a1);           // 预期 6
var a2 = 5;
check("++a2(表达式值)", ++a2);     // 预期 6
check("++a2(后值)", a2);           // 预期 6
var a3 = 5;
check("a3--(表达式值)", a3--);     // 预期 5
check("a3--(后值)", a3);           // 预期 4
var a4 = 5;
check("--a4(表达式值)", --a4);     // 预期 4
// 成员自增
var obj1 = {x: 10};
check("obj1.x++(表达式值)", obj1.x++);  // 预期 10
check("obj1.x(后值)", obj1.x);          // 预期 11
var obj2 = {y: 10};
check("++obj2.y(表达式值)", ++obj2.y);  // 预期 11

// ============ 7. 三元运算符 ============
console.log("=== [7] 三元运算符 ===");
check("1>0?yes:no", 1 > 0 ? "yes" : "no");   // 预期 yes
check("0>0?yes:no", 0 > 0 ? "yes" : "no");   // 预期 no
check("嵌套三元", 5 > 3 ? (2 > 1 ? "A" : "B") : "C");  // 预期 A

// ============ 8. 复合赋值 ============
console.log("=== [8] 复合赋值 ===");
var b1 = 5; b1 += 3; check("5+=3", b1);    // 预期 8
var b2 = 5; b2 -= 2; check("5-=2", b2);    // 预期 3
var b3 = 5; b3 *= 2; check("5*=2", b3);    // 预期 10
var b4 = 10; b4 /= 2; check("10/=2", b4);  // 预期 5
var b5 = 10; b5 %= 3; check("10%=3", b5);  // 预期 1

// ============ 9. 控制流 ============
console.log("=== [9] 控制流 ===");
var sum1 = 0;
for (var i = 1; i <= 5; i = i + 1) {
    sum1 = sum1 + i;
}
check("for求和1..5", sum1);       // 预期 15

// for + break
var sum2 = 0;
for (var i = 1; i <= 100; i = i + 1) {
    if (i > 5) { break; }
    sum2 = sum2 + i;
}
check("for+break", sum2);         // 预期 15

// for + continue
var sum3 = 0;
for (var i = 1; i <= 10; i = i + 1) {
    if (i % 2 == 0) { continue; }
    sum3 = sum3 + i;
}
check("for+continue(奇数和1..10)", sum3);  // 预期 25

// while
var w = 0;
var n = 5;
while (n > 0) {
    w = w + n;
    n = n - 1;
}
check("while递减求和", w);        // 预期 15

// do-while
var dw = 0;
var m = 0;
do {
    dw = dw + m;
    m = m + 1;
} while (m < 5);
check("do-while求和0..4", dw);    // 预期 10

// do-while 至少执行一次
var dw2 = 100;
var first = 0;
do {
    first = 1;
    dw2 = dw2 + 1;
} while (false);
check("do-while(false)执行一次", first);  // 预期 1

// switch
function sw(x) {
    var r = 0;
    switch (x) {
        case 1: { r = 100; break; }
        case 2: { r = 200; break; }
        case 3: { r = 300; break; }
        default: { r = 999; }
    }
    return r;
}
check("switch(1)", sw(1));        // 预期 100
check("switch(2)", sw(2));        // 预期 200
check("switch(9)", sw(9));        // 预期 999

// ============ 10. 函数：递归/闭包/this/返回值 ============
console.log("=== [10] 函数 ===");
function fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}
check("fib(10)", fib(10));        // 预期 55
check("fib(0)", fib(0));          // 预期 0
check("fib(1)", fib(1));          // 预期 1
check("fib(15)", fib(15));        // 预期 610

// 闭包计数器
function makeCounter() {
    var count = 0;
    return function() {
        count = count + 1;
        return count;
    };
}
var c1 = makeCounter();
check("闭包c1第1次", c1());       // 预期 1
check("闭包c1第2次", c1());       // 预期 2
check("闭包c1第3次", c1());       // 预期 3
var c2 = makeCounter();
check("闭包c2独立", c2());        // 预期 1

// this 绑定
var obj3 = {
    name: "Tom",
    getName: function() {
        return this.name;
    }
};
check("this.name", obj3.getName());  // 预期 Tom

// 无 return 的函数返回值
function noReturn() {
    var x = 1 + 2;
}
check("无return函数", noReturn());   // 预期 null

// 函数作为参数
function apply(fn, x) {
    return fn(x);
}
function double(x) { return x * 2; }
check("函数作参数", apply(double, 5));  // 预期 10

// ============ 11. 字符串 ============
console.log("=== [11] 字符串 ===");
check("'ab'+'cd'", "ab" + "cd");      // 预期 abcd
check("'a'+1", "a" + 1);              // 预期 a1
check("1+'a'", 1 + "a");              // 预期 1a
check("'x'+true", "x" + true);        // 预期 xtrue
check("'x'+null", "x" + null);        // 预期 xnull

// ============ 12. 对象与数组 ============
console.log("=== [12] 对象与数组 ===");
var obj4 = {a: 1, b: 2, c: 3};
check("obj4.a", obj4.a);              // 预期 1
check("obj4['b']", obj4["b"]);        // 预期 2
obj4.a = 100;
check("obj4.a修改后", obj4.a);        // 预期 100
obj4["d"] = 4;
check("obj4['d']新增", obj4.d);       // 预期 4
// 不存在属性
check("obj4.z(不存在)", obj4.z);      // 预期 null

var arr1 = [10, 20, 30];
check("arr1[0]", arr1[0]);            // 预期 10
check("arr1[2]", arr1[2]);            // 预期 30
arr1[1] = 99;
check("arr1[1]修改后", arr1[1]);      // 预期 99
// 数组求和(不能用arr.length)
var arrSum = arr1[0] + arr1[1] + arr1[2];
check("arr1求和", arrSum);            // 预期 10+99+30=139

// 嵌套对象
var nested = {outer: {inner: 42}};
check("嵌套对象", nested.outer.inner);  // 预期 42
nested.outer.inner = 99;
check("嵌套对象修改", nested.outer.inner);  // 预期 99

// ============ 13. 异常处理 ============
console.log("=== [13] 异常处理 ===");
// 基本 try-catch
function tryCatch() {
    try {
        throw "err1";
    } catch (e) {
        return "caught:" + e;
    }
}
check("try-catch", tryCatch());       // 预期 caught:err1

// finally 正常执行
var fin1 = 0;
function tryFinally() {
    try {
        fin1 = 1;
    } finally {
        fin1 = 2;
    }
}
tryFinally();
check("finally正常执行", fin1);       // 预期 2

// finally + try 有 return
var fin2 = 0;
function tryReturnFinally() {
    try {
        fin2 = 1;
        return "try-ret";
    } finally {
        fin2 = 2;
    }
}
var tr = tryReturnFinally();
check("try-return+finally返回值", tr);  // 预期 try-ret
check("try-return+finally副作用", fin2); // 预期 2

// finally + catch 有 return (debug_test 暴露的 bug)
var fin3 = 0;
function catchReturnFinally() {
    try {
        throw "e";
    } catch (e) {
        fin3 = 1;
        return "catch-ret";
    } finally {
        fin3 = 2;
    }
}
var cr = catchReturnFinally();
check("catch-return+finally返回值", cr);  // 预期 catch-ret
check("catch-return+finally副作用", fin3); // 预期 2

// finally 抛异常 (Bug #12: finally抛异常外层catch捕获不到，已修复)
function finallyThrow() {
    try {
        throw "first";
    } finally {
        throw "second";
    }
}
try {
    finallyThrow();
    check("finally抛异常", "未抛");
} catch (e) {
    check("finally抛异常", e);        // 预期 second
}

// 跨函数抛异常被调用者 catch 捕获
function throwAcross() {
    throw "cross";
}
try {
    throwAcross();
    check("跨函数抛异常", "未抛");
} catch (e) {
    check("跨函数抛异常", e);          // 预期 cross
}

// 嵌套 try
function nestedTry() {
    var log = "";
    try {
        log = log + "A";
        try {
            log = log + "B";
            throw "inner";
        } catch (e2) {
            log = log + "C";
        }
        log = log + "D";
    } catch (e1) {
        log = log + "X";
    }
    return log;
}
check("嵌套try", nestedTry());        // 预期 ABCD

// ============ 14. 作用域 ============
console.log("=== [14] 作用域 ===");
var x = "outer";
function scopeTest() {
    var x = "inner";
    return x;
}
check("作用域-内层", scopeTest());    // 预期 inner
check("作用域-外层未变", x);          // 预期 outer

// 块作用域遮蔽
var y = 1;
{
    var y = 2;
}
check("块作用域var", y);              // 预期 2 (JS var无块作用域) 或 1

// ============ 15. 字面量成员访问 ============
console.log("=== [15] 字面量成员访问 ===");
// 对象字面量后跟 .prop
check("{a:1}.a", {a: 1}.a);                       // 预期 1
check("{a:1,b:2}.b", {a: 1, b: 2}.b);             // 预期 2
// 对象字面量后跟 [expr]
check("{a:1}['a']", {a: 1}["a"]);                 // 预期 1
// 对象字面量链式访问
check("{a:{b:1}}.a.b", {a: {b: 1}}.a.b);          // 预期 1
check("{a:{b:{c:2}}}.a.b.c", {a: {b: {c: 2}}}.a.b.c);  // 预期 2
// 对象字面量后跟函数调用（字面量直接 .fn()，无需外层括号）
check("{fn:func}()", {fn: function() { return 42; }}.fn());  // 预期 42
// 数组字面量后跟 [index]
check("[1,2,3][0]", [1, 2, 3][0]);                // 预期 1
check("[1,2,3][2]", [1, 2, 3][2]);                // 预期 3
check("[10,20][1]", [10, 20][1]);                 // 预期 20
// 数组字面量链式
check("[[1,2],[3,4]][1][0]", [[1, 2], [3, 4]][1][0]);  // 预期 3
// null 字面量成员访问 → 抛 TypeError
try {
    null.foo;
    check("null.foo", "未抛");
} catch (e) {
    check("null.foo异常", e);                      // 预期 TypeError: Cannot read properties of null
}
// 数值字面量成员访问 → 静默返回 null (type<=3)
// 注意：42.foo 会被词法器解析为 FLOAT "42." + IDENTIFIER "foo"（与 JS 一致），
// 故需用 (42).foo 形式访问整数字面量属性；3.14.bar 可直接访问浮点字面量属性
check("(42).foo", (42).foo);                      // 预期 null
check("3.14.bar", 3.14.bar);                      // 预期 null
// 字符串字面量成员访问 → 返回 null (GSString 无该属性)
check("'str'.foo", "str".foo);                    // 预期 null
check("'str'[0]", "str"[0]);                      // 预期 null (gscript 字符串不支持索引)
// 布尔字面量成员访问 → 返回 null
check("true.x", true.x);                          // 预期 null
// 复合：字面量成员访问参与运算
check("算术参与", {a: 5}.a + 10);                  // 预期 15
check("数组参与", [1, 2, 3][0] + [1, 2, 3][2]);    // 预期 4
// 赋值给字面量成员访问的结果
var fromObj = {x: 99}.x;
check("赋值自字面量", fromObj);                    // 预期 99
// 字面量成员访问作为函数实参
function echo(v) { return v; }
check("字面量作实参", echo({a: 7}.a));             // 预期 7

// ============ 16. 多行注释 ============
console.log("=== [16] 多行注释 ===");
/* 这是块注释，应被完全忽略 */
check("块注释后", 1 + 1);                          // 预期 2
/* 跨越多行的
   块注释
   结束 */
check("多行块注释后", 2 + 2);                      // 预期 4
var x = 5; /* 行内块注释 */ check("行内块注释", x);  // 预期 5
/* 块注释含 / 字符路径 e:/foo/bar */
check("含斜杠块注释", 3 + 3);                      // 预期 6
// 单行注释仍正常
check("单行注释后", 4 + 4);                        // 预期 8

// ============ 17. JS 风格 if-else（单语句体无需大括号）============
console.log("=== [17] JS风格 if-else ===");
if (1 < 2) check("if无括号-true", "yes");          // 预期 yes
if (1 > 2) check("if无括号-false", "yes"); else check("if无括号-else", "no");  // 预期 no
var r1;
if (true) r1 = "a"; else r1 = "b";
check("if-else单语句", r1);                        // 预期 a
var r2;
if (false) r2 = "a"; else r2 = "b";
check("if-else单语句-false", r2);                  // 预期 b
// else if 链（单语句）
function classify(n) {
    if (n < 0) return "neg";
    else if (n == 0) return "zero";
    else return "pos";
}
check("classify(-1)", classify(-1));               // 预期 neg
check("classify(0)", classify(0));                 // 预期 zero
check("classify(5)", classify(5));                 // 预期 pos
// 嵌套 if 无括号
var r3;
if (true) if (false) r3 = "x"; else r3 = "y";
check("嵌套if无括号", r3);                         // 预期 y

// ============ 18. JS 风格 switch ============
console.log("=== [18] JS风格 switch ===");
// case 体无需大括号
function dayName(n) {
    switch (n) {
        case 1: return "Mon";
        case 2: return "Tue";
        case 3: return "Wed";
        default: return "Other";
    }
}
check("switch(1)", dayName(1));                    // 预期 Mon
check("switch(2)", dayName(2));                    // 预期 Tue
check("switch(3)", dayName(3));                    // 预期 Wed
check("switch(9)", dayName(9));                    // 预期 Other
// 无 default 的 switch（不匹配时安全跳过）
function noDefault(n) {
    var r = "none";
    switch (n) {
        case 1: r = "one"; break;
        case 2: r = "two"; break;
    }
    return r;
}
check("switch无default(1)", noDefault(1));         // 预期 one
check("switch无default(2)", noDefault(2));         // 预期 two
check("switch无default(9)", noDefault(9));         // 预期 none
// fall-through（无 break）
function fallthrough(n) {
    var r = "";
    switch (n) {
        case 1: r = r + "1";
        case 2: r = r + "2";
        case 3: r = r + "3"; break;
        case 4: r = "4"; break;
    }
    return r;
}
check("fallthrough(1)", fallthrough(1));           // 预期 123
check("fallthrough(2)", fallthrough(2));           // 预期 23
check("fallthrough(3)", fallthrough(3));           // 预期 3
check("fallthrough(4)", fallthrough(4));           // 预期 4
// 空 switch（不崩溃）
function emptySwitch(n) {
    switch (n) {}
    return "ok";
}
check("空switch", emptySwitch(1));                 // 预期 ok

// ============ 19. 十六进制字面量 ============
console.log("=== [19] 十六进制字面量 ===");
check("0xFF", 0xFF);                              // 预期 255
check("0x10", 0x10);                             // 预期 16
check("0xAB", 0xAB);                             // 预期 171
check("0xff", 0xff);                             // 预期 255 (小写x)
check("0x0", 0x0);                               // 预期 0
check("0xFF+1", 0xFF + 1);                       // 预期 256
check("0x10*2", 0x10 * 2);                       // 预期 32

// ============ 20. 字符串方法与 length ============
console.log("=== [20] 字符串方法 ===");
check("'hello'.length", "hello".length);           // 预期 5
check("''.length", "".length);                    // 预期 0
check("'hello'.charAt(0)", "hello".charAt(0));     // 预期 h
check("'hello'.charAt(4)", "hello".charAt(4));     // 预期 o
check("'hello'.charAt(10)", "hello".charAt(10));   // 预期 (空串)
check("'hello'.indexOf('ll')", "hello".indexOf("ll"));  // 预期 2
check("'hello'.indexOf('xyz')", "hello".indexOf("xyz")); // 预期 -1
check("'hello'.substring(1,3)", "hello".substring(1, 3));  // 预期 el
check("'hello'.substring(2)", "hello".substring(2));       // 预期 llo
check("'hello'.toUpperCase()", "hello".toUpperCase());     // 预期 HELLO
check("'Hello'.toLowerCase()", "Hello".toLowerCase());     // 预期 hello
// 字符串方法链式
check("链式", "hello".toUpperCase().charAt(0));    // 预期 H

// ============ 21. 数组 toString 与 length ============
console.log("=== [21] 数组 toString/length ===");
check("[1,2,3].length", [1, 2, 3].length);        // 预期 3
check("[].length", [].length);                    // 预期 0
check("[1,2,3]拼接", [1, 2, 3]);                  // 预期 1,2,3
check("['a','b']拼接", ["a", "b"]);               // 预期 a,b
check("空数组拼接", []);                          // 预期 (空串)
check("含null数组", [1, null, 3]);                // 预期 1,,3
check("数组+字符串", "v=" + [1, 2]);               // 预期 v=1,2

// ============ 22. 相等性语义修复 ============
console.log("=== [22] 相等性语义 ===");
check("NaN==NaN", NaN == NaN);                    // 预期 false (IEEE754)
check("NaN!=NaN", NaN != NaN);                    // 预期 true
check("NaN===NaN", NaN === NaN);                  // 预期 false
check("null=='null'", null == "null");            // 预期 false (null 仅等于 null)
check("null==0", null == 0);                      // 预期 false
check("null==null", null == null);                // 预期 true
check("null===null", null === null);              // 预期 true
check("'a'==='a'", "a" === "a");                  // 预期 true (值比较非引用)
check("'a'==='b'", "a" === "b");                  // 预期 false
check("1===1.0", 1 === 1.0);                      // 预期 true (int/float 互比)
check("1===2", 1 === 2);                          // 预期 false
check("'1'===1", "1" === 1);                      // 预期 false (类型不同)
// NaN 加法传播
check("1+NaN", 1 + NaN);                          // 预期 NaN
check("'x'+NaN", "x" + NaN);                      // 预期 xNaN (字符串优先)

// ============ 23. 空函数体与 console.log 多参数 ============
console.log("=== [23] 空函数体/多参数 ===");
var emptyFn = function() {};
check("空函数体调用", emptyFn());                  // 预期 null
function emptyDecl() {}
check("空声明函数调用", emptyDecl());              // 预期 null
console.log("多参数", "a", "b", "c");             // 预期 多参数 a b c
console.log("数值多参数", 1, 2, 3);               // 预期 数值多参数 1 2 3
console.log("混合多参数", "x", 42, true);         // 预期 混合多参数 x 42 true

console.log("=== 测试结束 ===");
