// 数组方法测试：splice
// 覆盖删除/插入/替换/负索引/deleteCount 缺省/清空
// 每个 check 打印 期望 vs 实际，便于人工核对

function check(name, expected, actual) {
    // 用 ==（松散相等）：string vs array 时一方为字符串会走 toStringValue 比较
    var mark = (expected == actual) ? "OK" : "FAIL";
    console.log("[" + mark + "] " + name + ": expected=" + expected + ", actual=" + actual);
}

console.log("=== [1] 删除 ===");
var a = [1, 2, 3, 4, 5];
var r = a.splice(1, 2);             // r=[2,3], a=[1,4,5]
check("splice删除-返回长度", 2, r.length);
check("splice删除-r[0]", 2, r[0]);
check("splice删除-r[1]", 3, r[1]);
check("splice删除-a长度", 3, a.length);
check("splice删除-a[0]", 1, a[0]);
check("splice删除-a[1]", 4, a[1]);
check("splice删除-a[2]", 5, a[2]);

console.log("=== [2] 插入（deleteCount=0）===");
var b = [1, 2, 3];
b.splice(1, 0, 9, 9);               // b=[1,9,9,2,3]
check("splice插入-长度", 5, b.length);
check("splice插入-b[0]", 1, b[0]);
check("splice插入-b[1]", 9, b[1]);
check("splice插入-b[2]", 9, b[2]);
check("splice插入-b[3]", 2, b[3]);
check("splice插入-b[4]", 3, b[4]);

console.log("=== [3] 替换（deleteCount=insertCount）===");
var c = [1, 2, 3];
c.splice(1, 1, 8);                  // c=[1,8,3]
check("splice替换-c[1]", 8, c[1]);
check("splice替换-长度", 3, c.length);
check("splice替换-c[0]", 1, c[0]);
check("splice替换-c[2]", 3, c[2]);

console.log("=== [4] 负索引 ===");
var d = [1, 2, 3];
d.splice(-1, 1);                    // d=[1,2]
check("splice负索引-长度", 2, d.length);
check("splice负索引-d[0]", 1, d[0]);
check("splice负索引-d[1]", 2, d[1]);

// 负索引超出范围归零
var d2 = [1, 2, 3];
d2.splice(-10, 1);                  // start=0, d2=[2,3]
check("splice负索引越界归零-长度", 2, d2.length);
check("splice负索引越界归零-d2[0]", 2, d2[0]);

console.log("=== [5] deleteCount 缺省（删到末尾）===");
var e = [1, 2, 3, 4];
e.splice(2);                        // e=[1,2]
check("splice缺省deleteCount-长度", 2, e.length);
check("splice缺省deleteCount-e[0]", 1, e[0]);
check("splice缺省deleteCount-e[1]", 2, e[1]);

console.log("=== [6] 清空 ===");
var f = [1, 2, 3];
f.splice(0);                        // f=[]
check("splice清空-长度", 0, f.length);

console.log("=== [7] deleteCount 大于剩余元素 ===");
var g = [1, 2, 3];
g.splice(1, 100);                   // g=[1]
check("splice deleteCount过大-长度", 1, g.length);
check("splice deleteCount过大-g[0]", 1, g[0]);

console.log("=== [8] deleteCount 为负数 ===");
var h = [1, 2, 3];
h.splice(1, -1, 9);                 // deleteCount=0, h=[1,9,2,3]
check("splice deleteCount负-长度", 4, h.length);
check("splice deleteCount负-h[1]", 9, h[1]);
check("splice deleteCount负-h[2]", 2, h[2]);

console.log("=== [9] start 大于 length ===");
var i = [1, 2, 3];
i.splice(10, 1, 99);                // start 截到 3, i=[1,2,3,99]
check("splice start过大-长度", 4, i.length);
check("splice start过大-i[3]", 99, i[3]);

console.log("=== [10] 不传参数 ===");
var j = [1, 2, 3];
j.splice();                         // 无操作, j=[1,2,3]
check("splice无参-长度", 3, j.length);
